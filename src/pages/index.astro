---
import { Image } from 'astro:assets';
import boardImage from '../assets/board-oslo-opera.jpeg';

const linkedInUrl = 'https://www.linkedin.com/company/la-french-tech-oslo/';
const memberUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLSfvYGNmmGMl80qx51hYOCvOyclK4D8FOotgXrJhjhknLRi0uw/viewform';
const canonicalUrl = 'https://www.frenchtech.no/';
const pageTitle = 'La French Tech Oslo | French-Norwegian Tech Community';
const pageDescription =
  'La French Tech Oslo connects French, Norwegian, and international founders, operators, investors, students, and tech talent in Oslo.';
const socialImageUrl = `${canonicalUrl}brand/social-card.jpg`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      url: canonicalUrl,
      name: 'La French Tech Oslo',
      alternateName: 'French Tech Oslo',
      inLanguage: 'en',
      publisher: { '@id': `${canonicalUrl}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${canonicalUrl}#organization`,
      name: 'La French Tech Oslo',
      alternateName: 'French Tech Oslo',
      url: canonicalUrl,
      description: pageDescription,
      logo: {
        '@type': 'ImageObject',
        url: `${canonicalUrl}FT_LOGOS_Communautes_Transparant.png`,
        width: 1842,
        height: 2274,
      },
      sameAs: [linkedInUrl],
    },
  ],
};

const benefits = [
  'Access the private WhatsApp group for local updates and introductions.',
  'Hear first about afterworks, talks, founder meetups, and partner events.',
  'Meet founders, operators, investors, students, and tech talent in Oslo.',
  'Build practical bridges between the French and Norwegian tech ecosystems.',
];

const pastEvents = [
  'Barbecue & Pétanque',
  'Cybersecurity in the Era of AI and New Geopolitical Threats',
  'The Femtech opportunity',
  'Webinar on capital taxes for French-Norwegians',
  'Working in Norway as an international',
];

const boardMembers = [
  {
    name: 'Christian Gaussen',
    linkedInUrl: 'https://www.linkedin.com/in/christiangaussen',
    roles: 'President',
  },
  {
    name: 'Michel Sagen',
    linkedInUrl: 'https://www.linkedin.com/in/michelsagen',
    roles: 'General Secretary & Treasurer · DeepTech Lead',
  },
  {
    name: 'Annabel Dangreville',
    linkedInUrl: 'https://www.linkedin.com/in/annabel-dangreville',
    roles:
      'General Secretary & Treasurer · Communications, Community & Inclusion · Impact, Energy & Mobility Lead',
  },
  {
    name: 'Alix Lardeau',
    linkedInUrl:
      'https://www.linkedin.com/in/alix-lardeau-prevost-digital-marketing-manager',
    roles: 'Communications, Community & Inclusion · Impact, Energy & Mobility Lead',
  },
  {
    name: 'Lene Fredly Rousseau',
    linkedInUrl: 'https://www.linkedin.com/in/lene-fredly-rousseau-a1371a2b',
    roles: 'Members, Events & Partnerships · DeepTech Lead',
  },
  {
    name: 'Thomas Bassetto',
    linkedInUrl: 'https://www.linkedin.com/in/thomasbassetto',
    roles: 'Members, Events & Partnerships · DeepTech Lead',
  },
  {
    name: 'Maxime Bousseaud',
    linkedInUrl: 'https://www.linkedin.com/in/maxime-bousseaud',
    roles: 'Members, Events & Partnerships · Impact, Energy & Mobility Lead',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={pageDescription}
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="La French Tech Oslo" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="La French Tech Oslo — the French Tech community in Oslo"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="La French Tech Oslo — the French Tech community in Oslo"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&family=Oswald:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Privacy-friendly analytics by Plausible -->
    <script
      is:inline
      async
      src="https://plausible.io/js/pa-CKUuujQV95W5Kdvr1C7WU.js"
    ></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__texture" aria-hidden="true"></div>

        <div class="hero__content">
          <div class="hero__copy">
            <h1 id="hero-title">The French Tech community in Oslo</h1>
            <p class="hero__lead">
              We connect founders, operators, investors, students, and tech
              talent across the French and Norwegian startup ecosystems.
            </p>
            <div class="actions">
              <a class="button button--primary" href={memberUrl}>Become a member (free)</a>
              <a class="button button--light" href={linkedInUrl}>Follow us on LinkedIn</a>
            </div>
          </div>

          <div class="hero__logo">
            <img
              src="/FT_LOGOS_Communautes_Transparant.png"
              alt="La French Tech Oslo"
              width="1842"
              height="2274"
              fetchpriority="high"
            />
          </div>
        </div>
      </section>

      <section class="section intro" id="community" aria-labelledby="community-title">
        <div class="section__heading">
          <h2 id="community-title">A local chapter with a global signal</h2>
        </div>
        <div class="intro__body">
          <p>
            La French Tech Oslo is the local community for people building,
            investing, studying, and operating in tech between France, Norway,
            and the broader international ecosystem.
          </p>
          <p>
            We create space for practical knowledge-sharing, useful
            introductions, events, and community conversations that help people
            move faster together.
          </p>
        </div>
      </section>

      <section class="campaign-band" aria-labelledby="purpose-title">
        <h2 class="campaign-band__statement" id="purpose-title">
          Let’s join forces to drive French Tech forward.
        </h2>
        <p>
          Official enough for partners. Direct enough for founders. Open to
          anyone who wants to contribute to the community.
        </p>
      </section>

      <section class="section events" aria-labelledby="events-title">
        <div class="section__heading section__heading--light">
          <h2 id="events-title">Past events</h2>
          <p>
            A few examples of the formats we bring to the community.
          </p>
        </div>

        <ul class="event-list">
          {pastEvents.map((event) => <li>{event}</li>)}
        </ul>
      </section>

      <section class="section membership" id="membership" aria-labelledby="membership-title">
        <div class="section__heading">
          <h2 id="membership-title">Membership</h2>
          <p>
            Join to stay close to the Oslo chapter and the people shaping it.
          </p>
        </div>

        <ul class="benefits">
          {benefits.map((benefit) => <li>{benefit}</li>)}
        </ul>

        <div class="final-cta">
          <a class="button button--primary" href={memberUrl}>Become a member (free)</a>
          <a class="button button--secondary" href={linkedInUrl}>Follow us on LinkedIn</a>
        </div>
      </section>

      <section class="board" aria-labelledby="board-title">
        <div class="board__image">
          <Image
            src={boardImage}
            alt="La French Tech Oslo board standing outside the Oslo Opera House"
            widths={[320, 480, 768]}
            sizes="(max-width: 820px) calc(100vw - 40px), 42vw"
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="board__content">
          <div class="section__heading">
            <h2 id="board-title">The board</h2>
            <p>
              La French Tech Oslo is run by a volunteer board covering
              community, events, partnerships, deeptech, impact, energy,
              mobility, communications, and inclusion.
            </p>
          </div>

          <ul class="board-list">
            {
              boardMembers.map((member) => (
                <li>
                  <a href={member.linkedInUrl} rel="noreferrer">
                    <strong>{member.name}</strong>
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                    >
                      <rect width="24" height="24" rx="2" fill="#0A66C2"></rect>
                      <path
                        fill="#FFFFFF"
                        d="M19.35 19.35h-3.1v-4.86c0-1.16-.03-2.65-1.62-2.65-1.61 0-1.86 1.26-1.86 2.57v4.94H9.66v-10h2.99v1.37h.04c.42-.79 1.43-1.62 2.94-1.62 3.14 0 3.72 2.07 3.72 4.76v5.49ZM6.16 7.98a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6Zm1.55 11.37H4.6v-10h3.11v10Z"
                      ></path>
                    </svg>
                  </a>
                  <span>{member.roles}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>La French Tech Oslo</p>
      <p>Oslo chapter of the La French Tech community.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --campaign-magenta: oklch(41.9% 0.168 7.5);
    --campaign-wine: oklch(35.8% 0.155 340.9);
    --campaign-violet: oklch(28.1% 0.169 280.4);
    --campaign-blue: oklch(59.7% 0.215 258);
    --campaign-cyan: oklch(62.2% 0.202 255.1);
    --french-tech-red: oklch(61.5% 0.252 29.2);
    --french-tech-red-deep: oklch(52.3% 0.215 29.2);
    --map-pin-grey: oklch(93.1% 0 89.9);
    --ink: oklch(24.4% 0 89.9);
    --black: oklch(0% 0 0);
    --white: oklch(100% 0 89.9);
    --page-max: 1120px;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  }

  * {
    box-sizing: border-box;
  }

  html {
    color: var(--ink);
    background: var(--white);
    font-family: Montserrat, Arial, sans-serif;
    line-height: 1.5;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    overflow-x: hidden;
  }

  a {
    color: inherit;
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    top: 12px;
    left: 12px;
    padding: 10px 14px;
    color: var(--white);
    background: var(--ink);
    font-weight: 700;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  img {
    display: block;
    max-width: 100%;
  }

  p,
  li,
  .campaign-band__statement {
    overflow-wrap: break-word;
  }

  h1,
  h2,
  h3 {
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .hero {
    position: relative;
    overflow: hidden;
    color: var(--ink);
    background:
      radial-gradient(circle at 86% 18%, oklch(93% 0.035 255 / 0.78), transparent 25rem),
      radial-gradient(circle at 8% 16%, oklch(96% 0.025 24 / 0.75), transparent 22rem),
      linear-gradient(112deg, var(--white), oklch(96% 0 0) 52%, oklch(93% 0.01 258));
  }

  .hero__texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.42;
    background:
      radial-gradient(circle at 52% 43%, transparent 0 1px, oklch(28% 0.16 280 / 0.12) 1px 2px, transparent 2px 100%),
      linear-gradient(118deg, transparent 24%, oklch(59.7% 0.215 258 / 0.14) 24.2%, transparent 24.6% 53%, oklch(41.9% 0.168 7.5 / 0.1) 53.2%, transparent 53.6%);
    background-size: 56px 56px, 100% 100%;
    mask-image: radial-gradient(ellipse at 63% 38%, black 0 42%, transparent 72%);
  }

  .hero__content,
  .section,
  .footer {
    width: min(var(--page-max), calc(100% - 40px));
    margin-inline: auto;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 440px);
    align-items: center;
    gap: clamp(32px, 7vw, 96px);
    min-height: clamp(560px, 78vh, 720px);
    padding-block: clamp(52px, 7vw, 92px);
  }

  .hero__copy,
  .intro__body,
  .section__heading {
    min-width: 0;
  }

  h1 {
    max-width: 12.5ch;
    margin: 0;
    font-size: clamp(2.65rem, 6.3vw, 4.25rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero__lead {
    max-width: 58ch;
    width: 100%;
    margin: 20px 0 0;
    color: oklch(32% 0 0);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.65;
    overflow-wrap: break-word;
  }

  .actions,
  .final-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    padding: 13px 18px;
    font-size: 0.94rem;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
    text-decoration: none;
    transition:
      transform 180ms var(--ease-out),
      background 180ms var(--ease-out),
      color 180ms var(--ease-out),
      border-color 180ms var(--ease-out);
  }

  .button:hover {
    transform: translateY(-1px);
  }

  a:focus-visible {
    outline: 3px solid var(--campaign-cyan);
    outline-offset: 3px;
  }

  .button--primary {
    background: var(--french-tech-red-deep);
    color: var(--white);
  }

  .button--primary:hover {
    background: oklch(45% 0.19 29.2);
  }

  .button--light {
    background: var(--white);
    color: var(--campaign-violet);
    border: 1px solid oklch(84% 0 0);
  }

  .button--secondary {
    border: 1px solid var(--ink);
    color: var(--ink);
  }

  .button--secondary:hover {
    border-color: var(--french-tech-red-deep);
    color: var(--french-tech-red-deep);
  }

  .hero__logo {
    position: relative;
    justify-self: end;
    width: clamp(260px, 28vw, 390px);
    padding: clamp(12px, 2vw, 20px);
    filter: drop-shadow(0 18px 34px rgb(0 0 0 / 10%));
  }

  .hero__logo img {
    width: 100%;
    height: auto;
  }

  .section {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 76px);
    padding-block: clamp(56px, 8vw, 104px);
  }

  .section h2 {
    margin: 0;
    max-width: 13.5ch;
    font-size: clamp(1.95rem, 4.1vw, 3.7rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .intro .section__heading {
    max-width: 620px;
  }

  .intro h2 {
    max-width: 15ch;
  }

  .section__heading p,
  .intro__body p {
    max-width: 65ch;
    margin: 20px 0 0;
    color: oklch(34% 0 0);
    font-size: clamp(1rem, 1.3vw, 1.14rem);
    line-height: 1.65;
  }

  .intro__body p:first-child {
    margin-top: 0;
  }

  .campaign-band {
    position: relative;
    overflow: hidden;
    width: min(var(--page-max), calc(100% - 40px));
    margin-inline: auto;
    padding: clamp(28px, 5vw, 52px);
    color: var(--white);
    background:
      radial-gradient(circle at 74% 38%, oklch(71% 0.18 245 / 0.42), transparent 20rem),
      linear-gradient(102deg, var(--campaign-magenta), var(--campaign-violet) 52%, var(--campaign-blue));
    border-radius: 8px;
  }

  .campaign-band::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background:
      radial-gradient(circle at 62% 50%, transparent 0 1px, oklch(100% 0 0 / 0.25) 1px 2px, transparent 2px 100%),
      linear-gradient(118deg, transparent 0 36%, oklch(100% 0 0 / 0.2) 36.2%, transparent 36.8% 100%);
    background-size: 48px 48px, 100% 100%;
    pointer-events: none;
  }

  .campaign-band p {
    position: relative;
    z-index: 1;
    max-width: 54ch;
    margin: 14px 0 0;
    color: oklch(100% 0 0 / 0.88);
    font-size: 1.05rem;
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  .campaign-band__statement {
    max-width: 18ch;
    margin: 0;
    color: var(--white);
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .events {
    width: auto;
    max-width: none;
    margin-top: clamp(56px, 7vw, 88px);
    padding-inline: max(20px, calc((100vw - var(--page-max)) / 2));
    color: var(--white);
    background:
      radial-gradient(circle at 82% 24%, oklch(70% 0.18 246 / 0.44), transparent 24rem),
      linear-gradient(104deg, var(--campaign-magenta), var(--campaign-violet) 50%, var(--campaign-blue));
  }

  .section__heading--light p {
    color: oklch(100% 0 0 / 0.82);
  }

  .event-list {
    display: grid;
    gap: 0;
    align-self: start;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid oklch(100% 0 0 / 0.24);
  }

  .event-list li {
    padding: 18px 0;
    border-bottom: 1px solid oklch(100% 0 0 / 0.24);
    color: oklch(100% 0 0 / 0.94);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .board {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 76px);
    width: min(var(--page-max), calc(100% - 40px));
    margin-inline: auto;
    padding-block: clamp(56px, 8vw, 104px);
  }

  .board__image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .board__content {
    min-width: 0;
  }

  .board-list {
    display: grid;
    gap: 0;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid oklch(86% 0 0);
  }

  .board-list li {
    display: grid;
    gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid oklch(86% 0 0);
  }

  .board-list strong {
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .board-list a {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 7px;
  }

  .board-list a svg {
    display: block;
    flex: 0 0 auto;
    align-self: center;
  }

  .board-list a:hover {
    color: var(--french-tech-red-deep);
  }

  .board-list span {
    color: oklch(38% 0 0);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .membership {
    align-items: start;
  }

  .benefits {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid oklch(86% 0 0);
  }

  .benefits li {
    padding: 22px 0;
    border-bottom: 1px solid oklch(86% 0 0);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.55;
  }

  .benefits li::before {
    content: "";
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 14px;
    background: var(--french-tech-red);
    transform: translateY(-1px) rotate(45deg);
  }

  .final-cta {
    grid-column: 2;
    margin-top: -48px;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-block: 28px;
    border-top: 1px solid oklch(88% 0 0);
    color: oklch(38% 0 0);
    font-size: 0.9rem;
  }

  .footer p {
    margin: 0;
  }

  .footer p:first-child {
    color: var(--ink);
    font-weight: 800;
  }

  @media (max-width: 820px) {
    .hero__content,
    .section,
    .board {
      grid-template-columns: 1fr;
    }

    .hero__content {
      min-height: auto;
    }

    .hero__logo {
      justify-self: start;
      width: min(260px, 72vw);
      order: -1;
    }

    .section h2 {
      max-width: 15ch;
    }

    .final-cta {
      grid-column: auto;
      margin-top: 0;
    }
  }

  @media (max-width: 560px) {
    .hero__content,
    .section,
    .board,
    .footer,
    .campaign-band {
      width: min(calc(100% - 28px), var(--page-max));
    }

    h1 {
      max-width: 9.6ch;
      font-size: clamp(1.95rem, 8.7vw, 2.35rem);
      line-height: 1;
    }

    .hero__content {
      padding-block: 34px 52px;
    }

    .hero__copy,
    .actions {
      max-width: calc(100vw - 56px);
    }

